# UnionBolts Platform — Database Environment Variables
# Copy to .env.local and fill in values

# Supabase PostgreSQL
SUPABASE_DB_HOST=db.xxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password

# Supabase Connection Pooling (PgBouncer — port 6543)
SUPABASE_POOLER_HOST=db.xxxxxxx.supabase.co
SUPABASE_POOLER_PORT=6543

# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Upstash or self-hosted)
REDIS_URL=redis://default:your-password@your-redis.upstash.io:6379

# Pinecone Vector DB
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=unionbolts-embeddings

# AI Services
DEEPSEEK_API_KEY=your-deepseek-api-key
TAVUS_API_KEY=your-tavus-api-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Google Pay
GOOGLE_PAY_MERCHANT_ID=your-google-pay-merchant-id
